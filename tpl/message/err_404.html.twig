{% extends "layout/page.html.twig" %}
{% set blHideBreadcrumb = true %}

{% block content %}
    <div class="err-404">
        <h1 class="page-header">{{ translate({ ident: "ERROR" }) }}</h1>
        <div class="row">
            <div class="col-md-6">
                <p>
                    {% if sUrl %}
                        {% set sModifiedUrl = sUrl|escape %}
                        {% set sModifiedUrl = "<i><strong>'"|cat(sModifiedUrl)|cat("'</strong></i>") %}
                        {# lang text escaped here; sModifiedUrl is markup around the escaped sUrl #}
                        {{ translate({ ident: "ERROR_404" })|e|replace({ '%s': sModifiedUrl })|raw }}
                    {% else %}
                        {{ translate({ ident: "ERROR_404" }) }}
                    {% endif %}
                </p>

                <p>
                    {{ translate({ ident: "DD_ERR_404_START_TEXT" }) }}<br>
                    <a href="{{ oViewConf.getHomeLink()|raw }}" class="btn btn-outline-dark" title="{{ translate({ ident: "DD_ERR_404_START_BUTTON" }) }}">{{ translate({ ident: "DD_ERR_404_START_BUTTON" }) }}</a>
                </p>

                <p>
                    {{ translate({ ident: "DD_ERR_404_CONTACT_TEXT" })|raw }}<br>
                    <a href="{{ seo_url({ ident: oViewConf.getSelfLink()|cat("cl=contact") }) }}" class="btn btn-outline-dark" title="{{ translate({ ident: "DD_ERR_404_CONTACT_BUTTON" }) }}">{{ translate({ ident: "DD_ERR_404_CONTACT_BUTTON" }) }}</a>
                </p>
            </div>
            <div class="col-md-6">
                <div class="gears-box hidden-xs">
                    <div class="paper-overlay"></div>
                    <img class="gear-rotate reverse" style="top: -55px; left: 65px;" src="{{ oViewConf.getImageUrl('404/gear.png') }}">
                    <img class="gear-rotate" style="top: 177px; left: -11px;" src="{{ oViewConf.getImageUrl('404/gear.png') }}">
                    <img class="gear-rotate" style="top: 19px; right: -26px;" src="{{ oViewConf.getImageUrl('404/gear.png') }}">
                </div>
            </div>
        </div>
    </div>
{% endblock %}
