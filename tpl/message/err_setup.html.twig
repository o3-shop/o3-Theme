{% capture append = "oxidBlock_pageBody" %}
    <h1 class="page-header">{{ translate({ ident: "ERROR_MESSAGE_OXID_SHOP_ERROR" }) }}</h1>
    {% set _error_content %}
        <div>
            <div>{{ translate({ ident: "ERROR_MESSAGE_OXID_SHOP_ERROR" }) }}</div>
            <div>{{ translate({ ident: "MESSAGE_PLEASE_DELETE_FOLLOWING_DIRECTORY", suffix: "COLON" }) }} {{ oViewConf.getBaseDir() }}/setup!</div>
        </div>
    {% endset %}
    {% include "message/error.html.twig" with {statusMessage: _error_content} %}
{% endcapture %}
{% include "layout/base.html.twig" %}
