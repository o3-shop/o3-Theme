{% block widget_locator_attributes %}
    {% if attributes %}
        {% set allActiveValue = sActiveValue %}

        <form method="get" action="{{ oViewConf.getSelfActionLink()|raw }}" name="_filterlist" class="alist__filter-form" data-js="listing:filter">
            <div class="d-none">
                {{ oViewConf.getHiddenSid()|raw }}
                {{ oViewConf.getNavFormParams()|raw }}
                <input type="hidden" name="cl" value="{{ oViewConf.getActiveClassName() }}">
                <input type="hidden" name="tpl" value="{{ oViewConf.getActTplName() }}">
                <input type="hidden" name="oxloadid" value="{{ oViewConf.getActContentLoadId() }}">
                <input type="hidden" name="fnc" value="executefilter">
                <input type="hidden" name="fname" value="">
            </div>

            {# initialised outside the loops: Twig drops variables first created inside a for loop #}
            {% set activeValuesClose = [] %}
            {% set hasActiveValue = false %}
            {% set allActiveValues = "" %}
            {% for sAttrID, oFilterAttr in attributes %}
                {% set sActiveValue = oFilterAttr.getActiveValue() %}

                {% if oFilterAttr.getValues()|length >= oViewConf.getViewThemeParam('blShowFiltersSearch') %}
                    {% set blCutValues = true %}
                {% else %}
                    {% set blCutValues = false %}
                {% endif %}

                <button type="button" class="btn" data-bs-toggle="collapse" data-bs-target="#filter{{ sAttrID }}" aria-controls="filter{{ sAttrID }}" aria-expanded="{% if oViewConf.getViewThemeParam('blShowFilters') %}true{% else %}false{% endif %}">
                    {{ oFilterAttr.getTitle() }}
                </button>

                <div class="collapse{% if oViewConf.getViewThemeParam('blShowFilters') %} show{% endif %}" id="filter{{ sAttrID }}">
                    <input type="hidden" name="attrfilter[{{ sAttrID }}]" value="{{ sActiveValue }}">

                    {% if blCutValues %}
                        <input class="form-control mb-3 pe-5" type="text" placeholder="{{ translate({ ident: "SEARCH" }) }}" data-js="listing:filter-search">
                    {% endif %}

                    <div data-js="listing:filter-values"{% if blCutValues %} data-value-number="{{ oViewConf.getViewThemeParam('blShowFiltersSearch') }}" style="max-height:calc({{ oViewConf.getViewThemeParam('blShowFiltersSearch') }} * 40px)"{% endif %}>
                        {% for sValue in oFilterAttr.getValues() %}
                            <div class="form-check"{% if blCutValues %} data-js="listing:filter-item"{% endif %}>
                                <input class="form-check-input" type="checkbox" value="{{ sValue }}" id="{{ sAttrID }}i{{ loop.index0 }}{% if offcanvas %}offcanvas{% endif %}"{% if sActiveValue == sValue %} checked{% endif %}>
                                <label class="form-check-label" for="{{ sAttrID }}i{{ loop.index0 }}{% if offcanvas %}offcanvas{% endif %}">
                                    {{ sValue }}
                                </label>
                            </div>

                            {% if sActiveValue %}
                                {% capture append = "activeValuesClose" %}
                                    <button type="button" data-delete="attrfilter[{{ sAttrID }}]" class="btn">
                                        {{ sValue }}
                                        <svg width="10" height="11" viewBox="0 0 10 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M1.5 2L8.5 9M1.5 9L8.5 2" stroke="#929292" stroke-width="1.5" stroke-linecap="square"/>
                                        </svg>
                                    </button>
                                {% endcapture %}
                            {% endif %}
                        {% endfor %}
                    </div>
                    {% if blCutValues %}
                        <button type="button" class="btn text-primary fw-bold p-0 mb-3" data-js="listing:filter-show-more" data-lang-more="{{ translate({ ident: "MORE" }) }}" data-lang-less="{{ translate({ ident: "O3_LESS" }) }}">
                            {{ translate({ ident: "MORE" }) }}
                            <svg width="10" height="11" viewBox="0 0 10 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1.875 4.25L5 6.75L8.125 4.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
                            </svg>
                        </button>
                    {% endif %}
                </div>

                {% if sActiveValue %}
                    {% set hasActiveValue = sActiveValue %}
                    {% set allActiveValues = allActiveValues|cat(sActiveValue)|cat(',') %}
                {% endif %}
            {% endfor %}

            <div class="alist__filter-active">
                {% for activeValueClose in activeValuesClose %}
                    {{ activeValueClose|raw }}
                {% endfor %}
            </div>
            <button data-js="listing:filter-apply" type="submit" class="alist__filter-apply btn btn-primary btn-lg d-md-none">{{ translate({ ident: "APPLY" }) }}</button>
        </form>

        {% if hasActiveValue %}
            <form method="get" action="{{ oViewConf.getSelfActionLink()|raw }}" name="_resetFilter" id="resetFilter" class="order-first">
                {{ oViewConf.getHiddenSid()|raw }}
                {{ oViewConf.getNavFormParams()|raw }}
                <input type="hidden" name="cl" value="{{ oViewConf.getActiveClassName() }}">
                <input type="hidden" name="fnc" value="resetFilter">

                <div class="title-small">{{ translate({ ident: "DD_LISTLOCATOR_FILTER_ATTRIBUTES" }) }}<span><button type="submit" class="btn">{{ translate({ ident: "DD_CATEGORY_RESET_BUTTON" }) }}</button></span></div>
            </form>
        {% else %}
            <div class="title-small order-first">{{ translate({ ident: "DD_LISTLOCATOR_FILTER_ATTRIBUTES" }) }}</div>
        {% endif %}
    {% endif %}
{% endblock %}