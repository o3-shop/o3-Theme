{% block widget_locator_paging %}
    {% if pages.changePage %}
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center{% if attributes %} offset-md-3{% endif %}">

                <li class="page-item{% if not pages.previousPage %} disabled{% endif %}">
                    {% if pages.previousPage %}
                        <a class="page-link" href="{{ pages.previousPage }}" aria-label="{{ translate({ ident: "PREVIOUS" }) }}">
                            <span aria-hidden="true">
                                <svg width="8" height="13" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M6.50015 11.5L1.88477 6.5L6.50015 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
                                </svg>
                            </span>
                            <span class="visually-hidden">{{ translate({ ident: "PREVIOUS" }) }}</span>
                        </a>
                    {% else %}
                        <span class="page-link">
                            <svg width="8" height="13" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M6.50015 11.5L1.88477 6.5L6.50015 1.5" stroke="rgba(17, 34, 17, 0.133333)" stroke-width="1.5" stroke-linecap="square"/>
                            </svg>
                        </span>
                    {% endif %}
                </li>

                {% set i = 1 %}
                {% for iPage, page in pages.changePage %}
                    {% if iPage == i %}
                        <li class="page-item {% if iPage == pages.actPage %} active{% endif %}">
                            <a href="{{ page.url }}" class="page-link">{{ iPage }}</a>
                        </li>
                        {% set i = i+1 %}
                    {% elseif iPage > i %}
                        <li class="page-item disabled">
                            <span>...</span>
                        </li>
                        <li class="page-item {% if iPage == pages.actPage %} active{% endif %}">
                            <a href="{{ page.url }}" class="page-link">{{ iPage }}</a>
                        </li>
                        {% set i = iPage+1 %}
                    {% elseif iPage < i %}
                        <li class="page-item {% if iPage == pages.actPage %} active{% endif %}">
                            <a href="{{ page.url }}" class="page-link">{{ iPage }}</a>
                        </li>
                        <li class="page-item disabled">
                            <span>...</span>
                        </li>
                        {% set i = iPage+1 %}
                    {% endif %}
                {% endfor %}

                <li class="page-item{% if not pages.nextPage %} disabled{% endif %}">
                    {% if pages.nextPage %}
                        <a class="page-link" href="{{ pages.nextPage }}" aria-label="{{ translate({ ident: "NEXT" }) }}">
                            <span aria-hidden="true">
                                <svg width="8" height="13" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M1.49985 1.5L6.11523 6.5L1.49985 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
                                </svg>
                            </span>
                            <span class="visually-hidden">{{ translate({ ident: "NEXT" }) }}</span>
                        </a>
                    {% else %}
                        <span class="page-link">
                            <svg width="8" height="13" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1.49985 1.5L6.11523 6.5L1.49985 11.5" stroke="rgba(17, 34, 17, 0.133333)" stroke-width="1.5" stroke-linecap="square"/>
                            </svg>
                        </span>
                    {% endif %}
                </li>
            </ul>
        </nav>
    {% endif %}
{% endblock %}