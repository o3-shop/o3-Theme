{% macro tree(categories, deepLevel, act, oView) %}
{% set deepLevel = deepLevel+1 %}
{% set oContentCat = oView.getContentCategory() %}
{% for _cat in categories %}
    {% if _cat.getIsVisible() %}
        {# CMS category #}
        {% if _cat.getContentCats() and deepLevel > 1 %}
            {% for _oCont in _cat.getContentCats() %}
                <li class="{% if oContentCat and oContentCat.getId()==_oCont.getId() %} active {% else %} end {% endif %}" >
                    <a href="{{ _oCont.getLink()|raw }}" title="{{ _oCont.oxcontents__oxtitle.value|raw }}"><i></i>{{ _oCont.oxcontents__oxtitle.value|raw }}</a>
                </li>
            {% endfor %}
        {% endif %}

        {# subcategories #}
        {% set oSubCats = _cat.getSubCats() %}
        <li class="{% if not oContentCat and act and act.getId()==_cat.getId() %}active{% elseif _cat.expanded %}exp{% endif %}{% if not _cat.hasVisibleSubCats %} end{% endif %}">
            <a href="{{ _cat.getLink()|raw }}" title="{{ _cat.oxcategories__oxtitle.value|raw }}">
                <i class="fa fa-caret-{% if _cat.expanded and oSubCats %}down{% else %}right{% endif %}"></i> {{ _cat.oxcategories__oxtitle.value|raw }} {% if oView.showCategoryArticlesCount() and (_cat.getNrOfArticles() > 0) %} ({{ _cat.getNrOfArticles() }}){% endif %}
            </a>
            {% if oSubCats and _cat.expanded %}
                <ul class="nav nav-pills nav-stacked">{{ _self.tree(oSubCats, deepLevel, act, oView) }}</ul>
            {% endif %}
        </li>
    {% endif %}
{% endfor %}
{% endmacro %}

{% block dd_widget_sidebar_categorytree %}
    {% if oxcmp_categories %}
        {% set categories = oxcmp_categories.getClickRoot() %}
        {% set act = oxcmp_categories.getClickCat() %}
        {% if categories %}
            {% set deepLevel = oView.getDeepLevel() %}
            <div class="categoryBox hidden-xs hidden-sm">
                {% block dd_widget_sidebar_categorytree_inner %}
                    <ol class="nav nav-pills nav-stacked cat-tree">
                        {% block dd_widget_sidebar_categorytree_list %}
                            {{ _self.tree(categories, deepLevel, act, oView) }}
                        {% endblock %}
                    </ol>
                {% endblock %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
