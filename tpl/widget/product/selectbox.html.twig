{# getLabel() (SelectList: oxtitle .value; VariantSelectList: htmlspecialchars) and Selection::getName() (htmlspecialchars) are HTML-escaped by the core, so |raw #}
{% set oSelections = oSelectionList.getSelections() %}
{% if oSelections %}
    <div class="dropDown">
        {% if not blHideLabel %}
            <label class="form-label" for="formSelect">{{ oSelectionList.getLabel()|raw }}</label>
        {% endif %}

        {% if editable is not same as(false) %}
            <select id="formSelect" class="form-select" aria-label="{{ oSelectionList.getLabel()|raw }}" name="{{ sFieldName|default("varselid") }}[{{ iKey }}]">

                <option value="">
                    {% if sFieldName == "sel" %}
                        {{ translate({ ident: "PLEASE_CHOOSE" }) }}
                    {% else %}
                        {{ translate({ ident: "CHOOSE_VARIANT" }) }}
                    {% endif %}
                </option>

                {% for oSelection in oSelections %}
                    <option {% if oSelection.isActive() %}selected{% endif %} value="{{ oSelection.getValue() }}">
                        {{ oSelection.getName()|raw }}
                    </option>
                {% endfor %}
            </select>
        {% endif %}
    </div>
{% endif %}