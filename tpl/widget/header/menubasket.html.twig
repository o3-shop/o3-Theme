<li class="fixed-header-item">
    <a href="{{ seo_url({ ident: oViewConf.getSelfLink()|cat("cl=basket") }) }}" rel="nofollow" class="fixed-header-link">
        <i class="fas fa-shopping-cart"></i>
        {% if oxcmp_basket is defined and oxcmp_basket.getItemsCount() > 0 %}
            <span class="badge">
                {{ oxcmp_basket.getItemsCount() }}
            </span>
        {% endif %}
    </a>
</li>
