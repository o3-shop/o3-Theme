{% extends "layout/page.html.twig" %}

{# 1.x registered js/widget/validate (in form/newsletter) before the header's scripts; registering it here, at the top level, keeps that
   order (the registration in form/newsletter is deduplicated by the core) #}
{% if oView.getNewsletterStatus() == 4 or not oView.getNewsletterStatus() %}
    {% if oxcmp_shop.oxshops__oxproductive.value %}
        {% do script({ include: "js/widget/validate.min.js", priority: 10 }) %}
    {% else %}
        {% do script({ include: "js/widget/validate.js", priority: 10 }) %}
    {% endif %}
{% endif %}

{% block content %}

    {% if oView.getNewsletterStatus() == 4 or not oView.getNewsletterStatus() %}
        <h1 class="title-big">{{ translate({ ident: "STAY_INFORMED" }) }}</h1>

        <hr>

        {% ifcontent ident "oxnewstlerinfo" set oCont %}
            {{ oCont.oxcontents__oxcontent.value|raw }}
        {% endifcontent %}

        {% include "form/newsletter.html.twig" %}

    {% elseif oView.getNewsletterStatus() == 1 %}

        <h1 class="title-big">{{ translate({ ident: "MESSAGE_THANKYOU_FOR_SUBSCRIBING_NEWSLETTERS" }) }}</h1>

        <p>{{ translate({ ident: "MESSAGE_SENT_CONFIRMATION_EMAIL" }) }}</p>

    {% elseif oView.getNewsletterStatus() == 2 %}

        <h1 class="title-big">{{ translate({ ident: "MESSAGE_NEWSLETTER_CONGRATULATIONS" }) }}</h1>

        <p>{{ translate({ ident: "MESSAGE_NEWSLETTER_SUBSCRIPTION_ACTIVATED" }) }}</p>

    {% elseif oView.getNewsletterStatus() == 3 %}

        <h1 class="title-big">{{ translate({ ident: "SUCCESS" }) }}</h1>

        <p>{{ translate({ ident: "MESSAGE_NEWSLETTER_SUBSCRIPTION_CANCELED" }) }}</p>

    {% endif %}

    {{ insert_tracker() }}
{% endblock %}
