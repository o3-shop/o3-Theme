{% set actCategory = oView.getActiveCategory() %}

{% if oxcmp_shop.oxshops__oxproductive.value %}
    {{ script({ include: "js/widget/filter.min.js", priority: 10, dynamic: __oxid_include_dynamic }) }}
{% else %}
    {{ script({ include: "js/widget/filter.js", priority: 10, dynamic: __oxid_include_dynamic }) }}
{% endif %}

{% capture append = "oxidBlock_sidebar" %}
    {% set listType = oView.getListType() %}
    {% if listType=='manufacturer' or listType=='vendor' %}
        {% if actCategory and actCategory.getIconUrl() %}
        <div class="box">
            <h3>
                {% if listType=='manufacturer' %}
                    {{ translate({ ident: "BRAND" }) }}
                {% elseif listType=='vendor' %}
                    {{ translate({ ident: "VENDOR" }) }}
                {% endif %}
            </h3>
            <img loading="lazy" src="{{ actCategory.getIconUrl() }}" alt="{{ actCategory.getTitle() }}">
        </div>
        {% endif %}
    {% endif %}
{% endcapture %}

{% capture append = "oxidBlock_content" %}
    {% block page_list_listhead %}
        {% if actCategory.oxcategories__oxthumb.value and actCategory.getThumbUrl() %}
            <img class="alist__image" src="{{ actCategory.getThumbUrl() }}" alt="{{ actCategory.oxcategories__oxtitle.value }}">
        {% endif %}

        {% set rsslinks = oView.getRssLinks() %}
        <h1 class="title-big">
            {{ oView.getTitle() }}
            {% if rsslinks.activeCategory %}
                <a class="rss" id="rssActiveCategory" aria-label="RSS Current Category" href="{{ rsslinks.activeCategory.link }}" title="{{ rsslinks.activeCategory.title }}" target="_blank">
                    <i class="fas fa-rss"></i>
                </a>
            {% endif %}
        </h1>

        {% if oView.getArticleList() %}
            {% block page_list_upperlocator %}
                {% include "widget/locator/listlocator.html.twig" with {locator: oView.getPageNavigationLimitedTop(), sort: true, itemsPerPage: true} %}
            {% endblock %}
        {% endif %}

        {% set oPageNavigation = oView.getPageNavigation() %}
        {% if actCategory.oxcategories__oxlongdesc.value and oPageNavigation.actPage == 1 %}
            <div id="catLongDescLocator" class="categoryDescription">{{ include(template_from_string(actCategory.oxcategories__oxlongdesc)) }}</div>
        {% endif %}

        {% if oView.hasVisibleSubCats() or oView.getAttributes() %}
            <div class="alist__orga">
                {% if oView.hasVisibleSubCats() %}

                    {# CMS content-category pills — always shown above grid regardless of toggle #}
                    {% set hasCmsCats = false %}
                    {% for category in oView.getSubCatList() %}
                        {% if category.getContentCats() %}{% set hasCmsCats = true %}{% endif %}
                    {% endfor %}
                    {% if hasCmsCats %}
                        <nav class="alist__orga-subcats" aria-label="{{ translate({ ident: "DD_LIST_SUBCATEGORIES_LABEL" }) }}">
                            {% for category in oView.getSubCatList() %}
                                {% if category.getContentCats() %}
                                    {% for ocont in category.getContentCats() %}
                                        <a class="btn" href="{{ ocont.getLink() }}">{{ ocont.oxcontents__oxtitle.value }}</a>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                        </nav>
                    {% endif %}

                    {% if oView.getClassName() != "manufacturerlist" %}

                        {% if oViewConf.getViewThemeParam('blShowSubcatTiles') %}
                            {# TILE GRID MODE #}
                            <div class="d-flex flex-wrap col-12">
                                {% for category in oView.getSubCatList() %}
                                    {% if category.getIsVisible() %}
                                        <div class="component__productbox col-12 col-sm-6 col-md-4 col-lg-3 col-xxxl-fifth">
                                            <div class="component__productbox-frame">
                                                {% set iconUrl = category.getIconUrl() %}
                                                {% if iconUrl %}
                                                    <div class="component__productbox-picture mb-4">
                                                        <a class="component__productbox-picture-link" href="{{ category.getLink() }}" title="{{ category.oxcategories__oxtitle.value }}">
                                                            <img loading="lazy" src="{{ iconUrl }}" alt="{{ category.oxcategories__oxtitle.value }}">
                                                        </a>
                                                    </div>
                                                {% else %}
                                                    <div class="component__productbox-picture mb-4">
                                                        <a href="{{ category.getLink() }}" class="btn btn-primary w-100 h-100 d-flex align-items-center justify-content-center">
                                                            {{ category.oxcategories__oxtitle.value }}
                                                        </a>
                                                    </div>
                                                {% endif %}
                                                <a href="{{ category.getLink() }}" class="component__productbox-title">
                                                    {{ category.oxcategories__oxtitle.value }}
                                                </a>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>

                        {% else %}
                            {# DEFAULT PILL MODE — identical to base o3-theme #}
                            <nav class="alist__orga-subcats" data-label="{{ translate({ ident: "DD_LIST_SUBCATEGORIES_LABEL" }) }}" aria-label="{{ translate({ ident: "DD_LIST_SUBCATEGORIES_LABEL" }) }}">
                                {% for category in oView.getSubCatList() %}
                                    {% if category.getContentCats() %}
                                        {% for ocont in category.getContentCats() %}
                                            <a class="btn" href="{{ ocont.getLink() }}">{{ ocont.oxcontents__oxtitle.value }}</a>
                                        {% endfor %}
                                    {% endif %}
                                    {% if category.getIsVisible() %}
                                        <a class="btn" href="{{ category.getLink() }}">{{ category.oxcategories__oxtitle.value }}</a>
                                    {% endif %}
                                {% endfor %}
                            </nav>

                        {% endif %}

                    {% else %}
                        {# Manufacturer list: always use icon-pill behavior #}
                        <nav class="alist__orga-subcats" data-label="{{ translate({ ident: "DD_LIST_SUBCATEGORIES_LABEL" }) }}" aria-label="{{ translate({ ident: "DD_LIST_SUBCATEGORIES_LABEL" }) }}">
                            {% for category in oView.getSubCatList() %}
                                {% if category.getContentCats() %}
                                    {% for ocont in category.getContentCats() %}
                                        <a class="btn" href="{{ ocont.getLink() }}">{{ ocont.oxcontents__oxtitle.value }}</a>
                                    {% endfor %}
                                {% endif %}
                                {% set iconUrl = category.getIconUrl() %}
                                {% if iconUrl %}
                                    <a class="start__manufacturer-box g-col-6 g-col-sm-4 g-col-lg-2" href="{{ category.getLink() }}" title="{{ translate({ ident: "VIEW_ALL_PRODUCTS" }) }}">
                                        <img src="{{ iconUrl }}" alt="{{ category.oxcategories__oxtitle.value }}">
                                    </a>
                                {% else %}
                                    <a class="btn" href="{{ category.getLink() }}">{{ category.oxcategories__oxtitle.value }}</a>
                                {% endif %}
                            {% endfor %}
                        </nav>

                    {% endif %}

                {% endif %}

                {% if oView.getAttributes() %}
                    <button type="button" class="btn btn-primary btn-lg d-lg-none w-100" data-bs-toggle="offcanvas" data-bs-target="#offcanvas__filter" aria-controls="offcanvas__filter">
                        <svg width="17" height="21" viewBox="0 0 17 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 4.5V1H15.5V4.5L10 9.5V19L6 16V9.5L1 4.5Z" stroke="white" stroke-width="1.5"/>
                        </svg>
                        {{ translate({ ident: "DD_LISTLOCATOR_FILTER_ATTRIBUTES" }) }}
                    </button>

                    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvas__filter">
                        <div class="offcanvas-header">
                            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>
                        <div class="offcanvas-body alist__filter">
                            {% include "widget/locator/attributes.html.twig" with {attributes: oView.getAttributes(), offcanvas: true} %}
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endif %}

    {% endblock %}

    {% block page_list_listbody %}
        {% if oView.getArticleList() %}

            {% block page_list_productlist %}
                <div class="row">
                    {% if oView.getAttributes() %}
                        <div class="alist__filter col-3">
                            {% include "layout/sidebar.html.twig" with {content: "attributes"} %}
                        </div>
                    {% endif %}
                    {% include "widget/product/list.html.twig" with {type: oView.getListDisplayType(), listId: "productList", products: oView.getArticleList()} %}
                </div>
            {% endblock %}

            {% block page_list_bottomlocator %}
                {% include "widget/locator/listlocator.html.twig" with {locator: oView.getPageNavigationLimitedBottom(), place: "bottom", attributes: oView.getAttributes()} %}
            {% endblock %}

        {% endif %}
    {% endblock %}
    {{ insert_tracker() }}
{% endcapture %}
{% include "layout/page.html.twig" with {tree_path: oView.getTreePath()} %}
