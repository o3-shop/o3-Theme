{#
    Tabs (2.x): Twig blocks get a copy of the context, so the 1.x pattern (each block appends to the "tabs" and
    "tabsContent" captures and resets blFirstTab, details_tabs_main prints them) cannot work across blocks.
    Instead every tab block is rendered twice by the loop below, in the 1.x order: once with tabPart == 'nav'
    (it prints its nav link) and, if that printed anything, once with tabPart == 'content' (it prints its pane).
    The non-empty results go to "tabs"/"tabsContent"; blFirstTab is true while the block is the first visible tab.
    All output and side effects of a tab block (includes, widgets, script()) must be gated by tabPart; one block
    yields at most one tab. A module adds a tab by overriding one of the (empty) tab blocks the same way.
    The definitions sit inside {% if false %}: a block in a template that does not extend is otherwise also rendered
    where it is defined; inside the if it stays registered (and overridable) for block().
#}
{% set tabPart = '' %}

{% if false %}
{% block details_tabs_longdescription %}
    {% hasrights { ident: "SHOWLONGDESCRIPTION" } %}
        {% set oLongdesc = oDetailsProduct.getLongDescription() %}
        {% if oLongdesc.value %}
            {% if tabPart == 'nav' %}<a class="nav-link{% if blFirstTab %} active{% endif %}" href="#details__description" role="tab" data-bs-toggle="tab" aria-controls="details__description" aria-selected="{% if blFirstTab %}true{% else %}false{% endif %}">{{ translate({ ident: "DESCRIPTION" }) }}</a>{% endif %}
            {% if tabPart == 'content' %}
                <div id="details__description" class="details__description tab-pane{% if blFirstTab %} active{% endif %}" role="tabpanel">
                    <h4 class="d-md-none">{{ translate({ ident: "DESCRIPTION" }) }}</h4>
                    <span itemprop="description">{{ oDetailsProduct.getLongDesc()|raw }}</span>
                    {% if oDetailsProduct.oxarticles__oxexturl.value %}
                        <a class="mt-5" href="{{ oDetailsProduct.oxarticles__oxexturl.value|raw }}">
                            {% if oDetailsProduct.oxarticles__oxurldesc.value %}
                                {{ oDetailsProduct.oxarticles__oxurldesc.value|raw }}
                            {% else %}
                                {{ oDetailsProduct.oxarticles__oxexturl.value|raw }}
                            {% endif %}
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    {% endhasrights %}
{% endblock %}

{% block details_tabs_attributes %}
    {% if oView.getAttributes() %}
        {% if tabPart == 'nav' %}<a class="nav-link{% if blFirstTab %} active{% endif %}" href="#details__attributes" role="tab" data-bs-toggle="tab" aria-controls="details__attributes" aria-selected="{% if blFirstTab %}true{% else %}false{% endif %}">{{ translate({ ident: "SPECIFICATION" }) }}</a>{% endif %}
        {% if tabPart == 'content' %}
            <div id="details__attributes" class="details__attributes tab-pane col-12 col-lg-8{% if blFirstTab %} active{% endif %}" role="tabpanel">
                <h4 class="d-md-none">{{ translate({ ident: "SPECIFICATION" }) }}</h4>
                {% include "page/details/inc/attributes.html.twig" %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block details_tabs_reviews %}
    {% if oView.isReviewActive() %}

        {% if tabPart == 'content' %}
            {% if oxcmp_shop.oxshops__oxproductive.value %}
                {{ script({ include: "js/widget/rating.min.js", priority: 10 }) }}
            {% else %}
                {{ script({ include: "js/widget/rating.js", priority: 10 }) }}
            {% endif %}
        {% endif %}

        {% if tabPart == 'nav' %}<a class="nav-link{% if blFirstTab %} active{% endif %}" href="#details__reviews" role="tab" data-bs-toggle="tab" aria-controls="details__reviews" aria-selected="{% if blFirstTab %}true{% else %}false{% endif %}">{{ translate({ ident: "REVIEWS" }) }} ({% if oView.getReviews() %}{{ oView.getReviews()|length }}{% else %}0{% endif %})</a>{% endif %}
        {% if tabPart == 'content' %}
            <div id="details__reviews" class="details__reviews tab-pane col-12 col-lg-8{% if blFirstTab %} active{% endif %}" role="tabpanel">
                <h4 class="d-md-none">{{ translate({ ident: "REVIEWS" }) }} ({% if oView.getReviews() %}{{ oView.getReviews()|length }}{% else %}0{% endif %})</h4>
                {% include "widget/reviews/reviews.html.twig" %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block details_tabs_tags %}
{% endblock %}

{% block details_tabs_media %}
    {% if oView.getMediaFiles() or oDetailsProduct.oxarticles__oxfile.value %}
        {% if tabPart == 'nav' %}<a class="nav-link{% if blFirstTab %} active{% endif %}" href="#details__media" role="tab" data-bs-toggle="tab" aria-controls="details__media" aria-selected="{% if blFirstTab %}true{% else %}false{% endif %}">{{ translate({ ident: "MEDIA" }) }}</a>{% endif %}
        {% if tabPart == 'content' %}
            <div id="details__media" class="details__media tab-pane col-12 col-lg-8{% if blFirstTab %} active{% endif %}" role="tabpanel">
                <h4 class="d-md-none">{{ translate({ ident: "MEDIA" }) }}</h4>
                {% include "page/details/inc/media.html.twig" %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{# 1.x wrapped this block in the bl_showPriceAlarm check; a Twig block cannot be defined conditionally #}
{% block details_tabs_pricealarm %}
    {% if oViewConf.getViewThemeParam('bl_showPriceAlarm') and oView.isPriceAlarm() and not oDetailsProduct.isParentNotBuyable() %}
        {% if tabPart == 'nav' %}<a class="nav-link{% if blFirstTab %} active{% endif %}" href="#details__pricealarm" role="tab" data-bs-toggle="tab" aria-controls="details__pricealarm" aria-selected="{% if blFirstTab %}true{% else %}false{% endif %}">{{ translate({ ident: "DD_PRICEALARM_HEADING" }) }}</a>{% endif %}
        {% if tabPart == 'content' %}
            <div id="details__pricealarm" class="details__pricealarm tab-pane col-12 col-lg-8{% if blFirstTab %} active{% endif %}" role="tabpanel">
                <h4 class="d-md-none">{{ translate({ ident: "DD_PRICEALARM_HEADING" }) }}</h4>
                {% include "form/pricealarm.html.twig" %}
            </div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block details_tabs_comments %}
{% endblock %}

{% block details_tabs_invite %}
{% endblock %}
{% endif %}

{% set tabs = [] %}
{% set tabsContent = [] %}
{% for sTabBlock in ['details_tabs_longdescription', 'details_tabs_attributes', 'details_tabs_reviews', 'details_tabs_tags', 'details_tabs_media', 'details_tabs_pricealarm', 'details_tabs_comments', 'details_tabs_invite'] %}
    {% set blFirstTab = tabs is empty %}
    {% set tabPart = 'nav' %}
    {% set sTab = block(sTabBlock) %}
    {% if sTab|trim %}
        {% set tabs = tabs|merge([sTab]) %}
        {% set tabPart = 'content' %}
        {% set tabsContent = tabsContent|merge([block(sTabBlock)]) %}
    {% endif %}
{% endfor %}

{% block details_tabs_main %}
    {% if tabs %}        
        <ul class="nav nav-tabs col-12 col-xl-8 d-none d-md-flex" role="tablist">
            {% for tab in tabs %}
                <li class="nav-item" role="presentation">{{ tab|raw }}</li>
            {% endfor %}
            {% block details_tabs_social_navigation %}{% endblock %}
        </ul>
        <div class="tab-content">
            {% for tabContent in tabsContent %}
                {{ tabContent|raw }}
            {% endfor %}
            {% block details_tabs_social_content %}{% endblock %}
        </div>        
    {% endif %}
{% endblock %}

