{% block details_relatedproducts_also_bought %}
    {% if oView.getAlsoBoughtTheseProducts() %}
        <div class="component__productslider">
            <h2 class="title-big">{{ translate({ ident: "CUSTOMERS_ALSO_BOUGHT" }) }}</h2>
            <hr>
            {% include "widget/product/list_splide.html.twig" with {listId: "alsoBought", products: oView.getAlsoBoughtTheseProducts()} %}
        </div>
    {% endif %}
{% endblock %}

