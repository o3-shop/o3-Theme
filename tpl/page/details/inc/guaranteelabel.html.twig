{# EU durability-guarantee label (Reg. (EU) 2025/1960 Annex II) - per-product, issue #219. #}
{# Contract: caller assigns oGuaranteeArticle (and optionally sGuaranteeContext) before including. #}
{# 1.x guarded the getters with method_exists() for older cores; 2.x requires the v2 core, which has all of them #}
{% if oGuaranteeArticle and oViewConf.getDurabilityGuaranteeLabelsEnabled() and oGuaranteeArticle.isDurabilityGuaranteeEligible() %}
    {% set sGuaranteeLabelUrl = oGuaranteeArticle.getDurabilityGuaranteeLabelUrl() %}
    {% set sGuaranteeNestedUrl = oGuaranteeArticle.getDurabilityGuaranteeNestedUrl() %}
    {% set sGuaranteeConditions = oGuaranteeArticle.getGuaranteeConditions() %}
    {% set sGuaranteeGuarantor = oGuaranteeArticle.getGuaranteeGuarantor() %}

    {% if sGuaranteeNestedUrl and sGuaranteeLabelUrl %}
        {# Official nested GARAN banner expands (CSS-only) to the full label plus conditions. #}
        <details class="o3-guarantee {{ sGuaranteeContext }}">
            <summary class="o3-guarantee__summary" title="{{ translate({ ident: "O3_GUARANTEE_LABEL_IMG_ALT" }) }}">
                <img src="{{ sGuaranteeNestedUrl }}" alt="{{ translate({ ident: "O3_GUARANTEE_LABEL_IMG_ALT" }) }}" loading="lazy" class="o3-guarantee__banner">
            </summary>
            <div class="o3-guarantee__panel">
                <a href="{{ sGuaranteeLabelUrl }}" target="_blank" rel="noopener" class="o3-guarantee__full">
                    <img src="{{ sGuaranteeLabelUrl }}" alt="{{ translate({ ident: "O3_GUARANTEE_LABEL_IMG_ALT" }) }}" loading="lazy" class="o3-guarantee__full-img">
                </a>
                {% if sGuaranteeConditions %}
                    <details class="o3-guarantee__conditions">
                        <summary>{{ translate({ ident: "O3_GUARANTEE_CONDITIONS_HEADING" }) }}</summary>
                        <div class="o3-guarantee__conditions-body">{{ sGuaranteeConditions|escape("html")|nl2br }}</div>
                    </details>
                {% endif %}
            </div>
        </details>
    {% elseif sGuaranteeLabelUrl %}
        {# Degradation: no nested banner asset, render the full label directly (small) plus conditions. #}
        <div class="o3-guarantee o3-guarantee--static {{ sGuaranteeContext }}">
            <a href="{{ sGuaranteeLabelUrl }}" target="_blank" rel="noopener" class="o3-guarantee__full">
                <img src="{{ sGuaranteeLabelUrl }}" alt="{{ translate({ ident: "O3_GUARANTEE_LABEL_IMG_ALT" }) }}" loading="lazy" class="o3-guarantee__full-img">
            </a>
            {% if sGuaranteeConditions %}
                <details class="o3-guarantee__conditions">
                    <summary>{{ translate({ ident: "O3_GUARANTEE_CONDITIONS_HEADING" }) }}</summary>
                    <div class="o3-guarantee__conditions-body">{{ sGuaranteeConditions|escape("html")|nl2br }}</div>
                </details>
            {% endif %}
        </div>
    {% elseif sGuaranteeGuarantor %}
        {# Last-resort text fallback: eligible + guarantor known but no artwork available. #}
        <div class="o3-guarantee o3-guarantee--fallback {{ sGuaranteeContext }}">
            <p class="o3-guarantee__fallback">
                {{ translate({ ident: "O3_GUARANTEE_LABEL_FALLBACK_DURATION", args: oGuaranteeArticle.getGuaranteeYears() }) }}
                ({{ translate({ ident: "O3_GUARANTEE_LABEL_FALLBACK_GUARANTOR", args: sGuaranteeGuarantor }) }}).
                {{ translate({ ident: "O3_GUARANTEE_LABEL_FALLBACK_NOTE" }) }}
                {{ translate({ ident: "O3_GUARANTEE_LEGAL_REMINDER" }) }}
            </p>
        </div>
    {% endif %}
{% endif %}
