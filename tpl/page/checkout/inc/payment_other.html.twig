<div class="form-check">
    <input value="{{ sPaymentID }}" class="form-check-input" type="radio" name="paymentid" id="payment_{{ sPaymentID }}" {% if oView.getCheckedPaymentId() == paymentmethod.oxpayments__oxid.value %}checked{% endif %}>
    <label class="form-check-label" for="payment_{{ sPaymentID }}">
        <span>
            {{ paymentmethod.oxpayments__oxdesc.value|raw }}

            {% if paymentmethod.getPrice() %}
                {% set oPaymentPrice = paymentmethod.getPrice() %}
                {% if oViewConf.isFunctionalityEnabled('blShowVATForPayCharge')  %}
                    {# 1.x [{strip}]: lines joined without whitespace; one space before the VAT label (1.6.9) #}
                    ({{ format_price(oPaymentPrice.getNettoPrice(), { currency: currency }) }}{% if oPaymentPrice.getVatValue() > 0 %} {{ translate({ ident: "PLUS_VAT" }) }} {{ format_price(oPaymentPrice.getVatValue(), { currency: currency }) }}{% endif %})
                {% else %}
                    ({{ format_price(oPaymentPrice.getBruttoPrice(), { currency: currency }) }})
                {% endif %}
            {% endif %}
        </span>

        {% for value in paymentmethod.getDynValues() %}
            <div class="form-group">
                {# value.name/value.value come from oxpayments.oxvaldesc getRawValue() (raw DB text): escaped #}
                <label class="control-label col-lg-3" for="{{ sPaymentID }}_{{ loop.index }}">{{ value.name|escape }}</label>
                <div class="col-lg-9">
                    <input id="{{ sPaymentID }}_{{ loop.index }}" type="text" class="form-control textbox" size="20" maxlength="64" name="dynvalue[{{ value.name|escape }}]" value="{{ value.value|escape }}">
                </div>
            </div>
        {% endfor %}

        {% block checkout_payment_longdesc %}
            {% if paymentmethod.oxpayments__oxlongdesc.value|striptags|trim %}
                <span class="desc">
                    {# admin-maintained HTML description, printed as HTML like in 1.x #}
                    {{ paymentmethod.oxpayments__oxlongdesc.getRawValue()|raw }}
                </span>
            {% endif %}
        {% endblock %}

    </label>
</div>