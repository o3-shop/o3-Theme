{% capture append = "oxidBlock_content" %}
    {% set template_title = "ORDER_HISTORY"|translate %}

    <div class="row">

        <div class="col-12 col-md-4 col-lg-3 mb-5">
            {% include "layout/sidebar.html.twig" with {content: "account", active_link: "orderhistory"} %}
        </div>

        {% set oOrders = oView.getOrderList() %}
        {% block account_order_history %}
            <div class="col-12 col-md-7 col-lg-8 offset-md-1">

                <h1 class="title-big">{{ translate({ ident: "ORDER_HISTORY" }) }}</h1>

                {% if oOrders and not empty(oOrders) %}
                    {% set oArticleList = oView.getOrderArticleList() %}

                    {% for order in oOrders %}
                        <div class="account_order">

                            {% if order.oxorder__oxstorno.value %}
                                <div class="account_order__status-danger">
                                    {{ translate({ ident: "ORDER_IS_CANCELED" }) }}
                                </div>
                            {% elseif order.oxorder__oxsenddate.value !="-" %}
                                <div class="account_order__status-success">
                                    {{ translate({ ident: "SHIPPED" }) }}
                                </div>
                            {% else %}
                                <div class="account_order__status-warning">
                                    {{ translate({ ident: "NOT_SHIPPED_YET" }) }}
                                </div>
                            {% endif %}

                            <div class="account_order__ordernumber">
                                <span>#{{ order.oxorder__oxordernr.value }}</span> - {{ order.oxorder__oxorderdate.value|date_format("%d.%m.%Y") }}
                            </div>

                            <div class="account_order__sum">
                                {{ format_price(order.oxorder__oxtotalordersum.value, { currency: currency }) }}
                            </div>

                            <button class="btn" type="button" data-bs-toggle="collapse" data-bs-target="#accOrderNo_{{ order.oxorder__oxordernr.value }}" aria-controls="accOrderNo_{{ order.oxorder__oxordernr.value }}" aria-expanded="false">
                                {{ translate({ ident: "MORE" }) }}
                            </button>
                        </div>

                        <div class="account_order__details collapse" id="accOrderNo_{{ order.oxorder__oxordernr.value }}">
                            <div class="col-12 col-lg-6 p-4">

                                <div class="title-small mb-3">{{ translate({ ident: "O3_ORDER_INFO" }) }}</div>
                                {# 
 <div class="account_order__details-payment">
 {{ translate({ ident: "PAYMENT_METHOD" }) }}
 {{ order.oxorder__oxpaymenttype.value }}
 </div>
 #}

                                {% set oDelSet = order.getDelSet() %}
                                <div class="account_order__details-delivery mb-3">
                                    {{ translate({ ident: "SHIPPING_CARRIER", suffix: "COLON" }) }}
                                    {{ oDelSet.oxdeliveryset__oxtitle.value }}
                                </div>

                                <div class="account_order__details-address">
                                    {{ translate({ ident: "SHIPMENT_TO", suffix: "COLON" }) }}

                                    <address class="mb-3">
                                        {% if order.oxorder__oxdelfname.value and                                            order.oxorder__oxdellname.value and                                            order.oxorder__oxdelstreet.value and                                            order.oxorder__oxdelstreetnr.value and                                            order.oxorder__oxdelzip.value and                                            order.oxorder__oxdelcity.value                                         %}
                                            {{ order.oxorder__oxdelcompany.value }}{% if order.oxorder__oxdelcompany.value %}<br>{% endif %}
                                            {{ order.oxorder__oxdelfname.value }} {{ order.oxorder__oxdellname.value }}<br>
                                            {{ order.oxorder__oxdelstreet.value }} {{ order.oxorder__oxdelstreetnr.value }}<br>
                                            {{ order.oxorder__oxdelzip.value }} {{ order.oxorder__oxdelcity.value }}<br>
                                            {{ order.oxorder__oxdelcountry.value }}
                                        {% else %}
                                            {{ order.oxorder__oxbillcompany.value }}{% if order.oxorder__oxbillcompany.value %}<br>{% endif %}
                                            {{ order.oxorder__oxbillfname.value }} {{ order.oxorder__oxbilllname.value }}<br>
                                            {{ order.oxorder__oxbillstreet.value }} {{ order.oxorder__oxbillstreetnr.value }}<br>
                                            {{ order.oxorder__oxbillzip.value }} {{ order.oxorder__oxbillcity.value }}<br>
                                            {{ order.oxorder__oxbillcountry.value }}
                                        {% endif %}
                                    </address>
                                </div>

                                {% if order.getShipmentTrackingUrl() %}
                                    <div class="account_order__details-tracking">
                                        {{ translate({ ident: "TRACKING_ID", suffix: "COLON" }) }}
                                        <a href="{{ order.getShipmentTrackingUrl() }}">{{ order.oxorder__oxtrackcode.value }}</a>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="col-12 col-lg-6 p-4">
                                {% block account_order_history_cart_items %}

                                    <div class="title-small">{{ translate({ ident: "O3_ARTICLE" }) }}</div>

                                    {% for orderitem in order.getOrderArticles(true) %}
                                        {% set sArticleId = orderitem.oxorderarticles__oxartid.value %}
                                        {% set oArticle = oArticleList[$sArticleId] %}

                                        <div class="account_order__details-article">
                                            <img src="{{ oArticle.getThumbnailUrl() }}" alt="{{ orderitem.oxorderarticles__oxtitle.value }}">
                                            <div>
                                                {{ orderitem.oxorderarticles__oxamount.value }} x
                                                {% if oArticle.oxarticles__oxid.value and oArticle.isVisible() %}
                                                    <a id="accOrderLink_{{ order.oxorder__oxordernr.value }}_{{ loop.index }}" href="{{ oArticle.getLink() }}">
                                                {% endif %}
                                                {{ orderitem.oxorderarticles__oxtitle.value }} {{ orderitem.oxorderarticles__oxselvariant.value }} <span class="amount"></span>
                                                {% if oArticle.oxarticles__oxid.value and oArticle.isVisible() %}
                                                    </a>
                                                {% endif %}

                                                {% for sVar, aParam in orderitem.getPersParams() %}
                                                {% if aParam %}
                                                    <br />{{ translate({ ident: "DETAILS" }) }}: {{ aParam }}
                                                {% endif %}
                                                {% endfor %}
                                            </div>
                                            <div class="flex-grow-1 text-end fw-bold text-nowrap">
                                                {{ format_price(oArticle.oxarticles__oxprice.value, { currency: currency }) }}
                                            </div>
                                        </div>
                                    {% endfor %}

                                {% endblock %}
                            </div>
                        </div>
                    {% endfor %}

                    {% include "widget/locator/listlocator.html.twig" with {locator: oView.getPageNavigation(), place: "bottom"} %}
                {% else %}
                    <hr>
                    <p class="alert alert-info">{{ translate({ ident: "ORDER_EMPTY_HISTORY" }) }}</p>
                {% endif %}
            </div>
        {% endblock %}
    </div>
    {{ insert_tracker({title: template_title}) }}
{% endcapture %}

{% include "layout/page.html.twig" %}