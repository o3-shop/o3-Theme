{% capture append = "oxidBlock_content" %}

    <div class="row">

        <div class="col-12 col-md-4 col-lg-3 mb-5">
            {% include "layout/sidebar.html.twig" with {content: "account", active_link: "reviewlist"} %}
        </div>

        <div class="col-12 col-md-7 col-lg-8 offset-md-1">

            {% block account_reviewlist_header %}
                {% set template_title = "MY_REVIEWS"|translate %}
                <h1 class="title-big">{{ translate({ ident: "MY_REVIEWS" }) }}</h1>
            {% endblock %}

            {% block account_reviewlist_list %}

                {% if oView.getReviewAndRatingItemsCount()  %}

                    {% for review in oView.getReviewList() %}
                        {% block account_reviewlist_item %}

                            <div class="account_review" itemprop="review" itemscope itemtype="https://schema.org/Review">

                                <div>
                                    <strong itemprop="itemreviewed">{{ review.getObjectTitle()|truncate(60) }}</strong><time itemprop="datePublished" datetime="{{ review.getCreatedAt()|date_format("%Y-%m-%d") }}">{{ review.getCreatedAt()|date_format("%d.%m.%Y") }}</time>
                                </div>

                                {% if review.getRating() %}
                                    <div class="account_review__rating" itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating">
                                        {% for starRatings in 0..5 %}
                                            {% if review.getRating() >= smarty.section.starRatings.iteration %}
                                                <div class="star filled"></div>
                                            {% else %}
                                                <div class="star"></div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                {% endif %}

                                {% if review.getReviewText() %}
                                    <div itemprop="description">{{ review.getReviewText() }}</div>
                                {% endif %}

                                {% block account_reviewlist_item_action %}
                                    <button type="submit" class="btn btn-danger" title="{{ translate({ ident: "DD_DELETE_REVIEW_AND_RATING" }) }}" data-bs-toggle="modal" data-bs-target="#delete_review_{{ loop.index }}">
                                        {{ translate({ ident: "DD_DELETE" }) }}
                                    </button>
                                {% endblock %}
                            </div>
                        {% endblock %}

                        {% include "page/account/delete_review_confirmation.html.twig" with {reviewId: review.getReviewId(), ratingId: review.getRatingId(), reviewCounterIteration: loop.index} %}
                    {% endfor %}

                {% else %}
                    {% block account_reviewlist_no_reviews_available %}
                        <div class="alert alert-info">
                            {{ translate({ ident: "DD_REVIEWS_NOT_AVAILABLE" }) }}
                        </div>
                    {% endblock %}
                {% endif %}

            {% endblock %}

            {% block account_reviewlist_locator %}
                {% include "widget/locator/listlocator.html.twig" with {locator: oView.getPageNavigation(), place: "bottom"} %}
            {% endblock %}

        </div>
    </div>
    {{ insert_tracker({title: template_title}) }}
{% endcapture %}

{% include "layout/page.html.twig" %}
