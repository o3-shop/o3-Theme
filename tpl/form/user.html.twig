
{# capture assign="sValidationJS"}]
 {% spaceless %}
 $('input,select,textarea').not('[type=submit]').jqBootstrapValidation(
 {
 filter: function()
 {
 return $(this).is(':visible');
 }
 }
 );
 {% endspaceless %}
[{/capture #}

{# oxscript add=$sValidationJS #}
{% block user %}

    {% if oxcmp_shop.oxshops__oxproductive.value %}
        {{ script({ include: "js/widget/shippingaddress.min.js", priority: 10 }) }}
    {% else %}
        {{ script({ include: "js/widget/shippingaddress.js", priority: 10 }) }}
    {% endif %}

    <form action="{{ oViewConf.getSelfActionLink() }}" name="order" method="post" class="needs-validation" novalidate>
        {% block user_form %}
            {% set aErrors = oView.getFieldValidationErrors() %}

            <div class="d-none">
                {{ oViewConf.getHiddenSid() }}
                {{ oViewConf.getNavFormParams() }}
                <input type="hidden" name="fnc" value="changeuser_testvalues">
                <input type="hidden" name="cl" value="account_user">
                <input type="hidden" name="CustomError" value='user'>
                <input type="hidden" name="blshowshipaddress" value="1">
            </div>

            {# Rechnungsadresse #}
            <div class="user__billingaddress mb-5">
                <h3 class="title-small">
                    {% block user_billing_address_head %}
                        {{ translate({ ident: "BILLING_ADDRESS" }) }}
                        <button type="button" type="button" class="btn btn-edit" data-bs-toggle="collapse" data-bs-target="#user__billingaddress-address, #user__billingaddress-form" aria-controls="user__billingaddress-address, user__billingaddress-form">
                            {{ translate({ ident: "CHANGE" }) }}
                        </button>
                    {% endblock %}
                </h3>

                {% block user_billing_address %}
                    {% block user_billing_address_text %}
                        {% include "widget/address/billing_address.html.twig" with {collapse: "user__billingaddress-address"} %}
                    {% endblock %}
                    {% block user_billing_address_form %}
                        <div id="user__billingaddress-form" class="user__billingaddress-form collapse">
                            {% include "form/fieldset/user_email.html.twig" %}
                            {% include "form/fieldset/user_billing.html.twig" with {noFormSubmit: true} %}
                        </div>
                    {% endblock %}
                {% endblock %}

            </div>

            {# oxscript add="$('#userChangeAddress').click( function() { $('#addressForm, #addressText').toggle();return false;});" #}

            {# Lieferadresse #}
            {% block user_shipping_address %}
                <div class="user__shippingaddress mb-5">
                    <h3 class="title-small">
                        {% block user_shipping_address_head %}
                            {{ translate({ ident: "SHIPPING_ADDRESSES" }) }}
                        {% endblock %}
                    </h3>

                    {% block user_shipping_address_choice %}
                        <div class="form-check">
                            <input data-bs-toggle="collapse" data-bs-target="#user__shippingaddress-change" class="form-check-input" type="checkbox" name="blshowshipaddress" value="0" id="user__shippingaddress-chance"{% if not oView.showShipAddress() %} checked{% endif %} aria-controls="user__shippingaddress-change">
                            <label class="form-check-label" for="user__shippingaddress-chance">
                                {{ translate({ ident: "USE_BILLINGADDRESS_FOR_SHIPPINGADDRESS" }) }}
                            </label>
                        </div>
                    {% endblock %}

                    {% block user_shipping_address_form %}
                        <div id="user__shippingaddress-change" class="user__shippingaddress-change collapse{% if oView.showShipAddress() %} show{% endif %}">
                            {% include "form/fieldset/user_shipping.html.twig" with {noFormSubmit: true} %}
                        </div>
                    {% endblock %}
                </div>

                {# oxscript add="$('#showShipAddress').change( function() { $('#shippingAddress').toggle($(this).is(':not(:checked)')); });" #}
            {% endblock %}

            <button id="accUserSaveTop" class="btn btn-primary" name="userform" type="submit">{{ translate({ ident: "SAVE" }) }}</button>

        {% endblock %}
    </form>
    {% include "form/fieldset/delete_shipping_address_modal.html.twig" %}
{% endblock %}
