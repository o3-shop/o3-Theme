<div class="wishlistSuggest clear">
    {% if oView.getWishList() and oView.showSuggest() %}
        {% if Errors.account_whishlist|is_array and not empty(Errors.account_whishlist) %}
            {% for key, oEr in Errors.account_whishlist %}
                <p class="alert alert-danger">{{ oEr.getOxMessage() }}</p>
            {% endfor %}
        {% endif %}
        {# editval: request-escaped by the core (AccountWishlistController::sendWishList, getRequestEscapedParameter), so |raw #}
        {% set editval = oView.getEnteredData() %}
        <form action="{{ oViewConf.getSelfActionLink()|raw }}" method="post" class="form-horizontal">
            <div class="d-none">
                {{ oViewConf.getHiddenSid()|raw }}
                <input type="hidden" name="fnc" value="sendwishlist">
                <input type="hidden" name="cl" value="account_wishlist">
                <input type="hidden" name="blshowsuggest" value="1">
                <input type="hidden" name="editval[send_subject]" value="{{ translate({ ident: "GIFT_REGISTRY_OF" }) }} {{ oxcmp_shop.oxshops__oxname.value|raw }}">
                <input type="hidden" name="CustomError" value='account_whishlist'>
            </div>
                <span class="lead">{{ translate({ ident: "SEND_GIFT_REGISTRY" }) }}</span>

                <div class="form-group">
                    <label class="control-label col-lg-3">{{ translate({ ident: "RECIPIENT_NAME" }) }}</label>
                    <div class="col-lg-9">
                        <input type="text" name="editval[rec_name]" class="form-control" maxlength="70" value="{{ editval.rec_name|raw }}">
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-lg-3">{{ translate({ ident: "RECIPIENT_EMAIL" }) }}</label>
                    <div class="col-lg-9">
                        <input type="email" name="editval[rec_email]" class="form-control" maxlength="70" value="{{ editval.rec_email|raw }}">
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label col-lg-3">{{ translate({ ident: "MESSAGE" }) }}</label>
                    <div class="col-lg-9">
                        <textarea rows="6" class="form-control" name="editval[send_message]">{% if editval.send_message %}{{ editval.send_message|raw }}{% else %}{{ translate({ ident: "SHOP_SUGGEST_BUY_FOR_ME", args: oxcmp_shop.oxshops__oxname.getRawValue() }) }}{% endif %}</textarea>
                    </div>
                </div>
                <div class="form-group">
                    <div class="offset-lg-3 col-lg-9">
                        <button class="btn btn-primary" type="submit">{{ translate({ ident: "SUBMIT" }) }}</button>
                    </div>
                </div>
        </form>
        <hr>
    {% endif %}
</div>