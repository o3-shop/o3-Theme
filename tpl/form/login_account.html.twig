{% if oxcmp_shop.oxshops__oxproductive.value %}
    {{ script({ include: "js/widget/validate.min.js", priority: 10 }) }}
{% else %}
    {{ script({ include: "js/widget/validate.js", priority: 10 }) }}
{% endif %}

{% if oView.getAccountDeletionStatus() == true %}
    {% set statusMessage = "DD_DELETE_MY_ACCOUNT_SUCCESS"|translate %}
    {% include "message/success.html.twig" with {statusMessage: statusMessage} %}
{% endif %}
<div class="row">
    <form name="login" action="{{ oViewConf.getSslSelfLink()|raw }}" method="post" class="needs-validation col-12 col-md-6 col-lg-5 mb-5" novalidate>
        <div class="d-none">
            {{ oViewConf.getHiddenSid()|raw }}
            {{ oViewConf.getNavFormParams()|raw }}
            <input type="hidden" name="fnc" value="login_noredirect">
            <input type="hidden" name="cl" value="{{ oViewConf.getActiveClassName() }}">
            <input type="hidden" name="tpl" value="{{ oViewConf.getActTplName() }}">
            <input type="hidden" name="oxloadid" value="{{ oViewConf.getActContentLoadId() }}">
            {% if oView.getArticleId() %}
                <input type="hidden" name="aid" value="{{ oView.getArticleId() }}">
            {% endif %}
            {% if oView.getProduct() %}
                {% set product = oView.getProduct() %}
                <input type="hidden" name="anid" value="{{ product.oxarticles__oxnid.value|raw }}">
            {% endif %}
        </div>

        <h2 class="title-big">{{ translate({ ident: "LOGIN" }) }}</h2>

        <div class="form-floating mb-4">
            <input type="email" class="form-control" id="loginUser" name="lgn_usr" placeholder="{{ translate({ ident: "EMAIL" }) }}" required autocomplete="username">
            <label for="loginUser">{{ translate({ ident: "EMAIL" }) }}</label>
            <div class="invalid-feedback">
                {{ translate({ ident: "DD_FORM_VALIDATION_VALIDEMAIL" }) }}
            </div>
        </div>

        <div class="form-floating mb-3">
            <input type="password" class="form-control" id="loginPwd" name="lgn_pwd" placeholder="{{ translate({ ident: "PASSWORD" }) }}" required autocomplete="current-password">
            <label for="loginPwd">{{ translate({ ident: "PASSWORD" }) }}</label>
            <div class="invalid-feedback">
                {{ translate({ ident: "ERROR_MESSAGE_INPUT_EMPTYPASS" }) }}
            </div>
        </div>

        <div class="d-flex justify-content-between">
            {% if oView.showRememberMe() %}
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="lgn_cook" value="1" id="remember-me">
                    <label class="form-check-label" for="remember-me">
                        {{ translate({ ident: "KEEP_LOGGED_IN" }) }}
                    </label>
                </div>
            {% endif %}

            <a href="{{ seo_url({ ident: oViewConf.getSelfLink()|cat("cl=forgotpwd") }) }}" class="account__login-forget">{{ translate({ ident: "FORGOT_PASSWORD" }) }}</a>
        </div>

        <button type="submit" class="btn btn-primary">{{ translate({ ident: "LOGIN" }) }}</button>
    </form>

    <div class="col-12 col-md-5 offset-md-1 offset-lg-2">
        <h2 class="title-big">{{ translate({ ident: "OPEN_ACCOUNT" }) }}</h2>
        <p>{{ translate({ ident: "DD_LOGIN_ACCOUNT_PANEL_CREATE_BODY" }) }}</p>
        <a href="{{ seo_url({ ident: oViewConf.getSslSelfLink()|cat("cl=register") }) }}" class="btn btn-primary" role="button">{{ translate({ ident: "OPEN_ACCOUNT" }) }}</a>
    </div>
</div>