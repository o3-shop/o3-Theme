{% block form_user_billing_birthdate %}
    {% if oViewConf.showBirthdayFields() %}

        {% if oxcmp_shop.oxshops__oxproductive.value %}
            {{ script({ include: "js/widget/birthdate.min.js", priority: 10 }) }}
        {% else %}
            {{ script({ include: "js/widget/birthdate.js", priority: 10 }) }}
        {% endif %}

        {% set birthdate_complete = iBirthdayYear ~ "-" ~ iBirthdayMonth ~ "-" ~ iBirthdayDay %}

        <div class="form-floating mb-3">
            <input data-js="birthdate" id="invadr_oxuser__oxbirthdate" class="form-control" type="date" {% if birthdate_complete %}value="{{ birthdate_complete|raw }}"{% endif %} placeholder="{{ translate({ ident: "BIRTHDATE" }) }}{% if oView.isFieldRequired("oxuser__oxbirthdate") %}*{% endif %}"{% if oView.isFieldRequired("oxuser__oxbirthdate") %} required{% endif %}>
            <label for="invadr_oxuser__oxbirthdate">{{ translate({ ident: "BIRTHDATE" }) }}{% if oView.isFieldRequired("oxuser__oxbirthdate") %}*{% endif %}</label>
            <div class="invalid-feedback">
                {{ translate({ ident: "O3_FORM_VALIDATION_BIRTHDATE" }) }}
            </div>
            {% include "message/inputvalidation.html.twig" with {aErrors: aErrors.oxuser__oxbirthdate} %}

            <input type="hidden" data-js="birthdate-day" name="invadr[oxuser__oxbirthdate][day]" value="{% if iBirthdayDay %}{{ iBirthdayDay|raw }}{% endif %}">
            <input type="hidden" data-js="birthdate-month" name="invadr[oxuser__oxbirthdate][month]" value="{% if iBirthdayMonth %}{{ iBirthdayMonth|raw }}{% endif %}">
            <input type="hidden" data-js="birthdate-year" name="invadr[oxuser__oxbirthdate][year]" value="{% if iBirthdayYear %}{{ iBirthdayYear|raw }}{% endif %}">

        </div>

    {% endif %}
{% endblock %}

