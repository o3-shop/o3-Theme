{% block form_user_billing_country %}
    <div class="form-floating mb-3">
        <select class="form-select" id="invCountrySelect" name="invadr[oxuser__oxcountryid]"{% if oView.isFieldRequired("oxuser__oxcountryid") %} required{% endif %} autocomplete="billing country">
            <option value="">-</option>
            {% set blCountrySelected = false %}
            {% for country_id, country in oViewConf.getCountryList() %}
                {% set sCountrySelect = "" %}
                {% if not blCountrySelected %}
                    {% if (invadr.oxuser__oxcountryid is not null and invadr.oxuser__oxcountryid == country.oxcountry__oxid.value) or                    (invadr.oxuser__oxcountryid is null and oxcmp_user.oxuser__oxcountryid.value == country.oxcountry__oxid.value) %}
                        {% set blCountrySelected = true %}
                        {% set sCountrySelect = "selected" %}
                    {% endif %}
                {% endif %}
                <option value="{{ country.oxcountry__oxid.value|raw }}" {{ sCountrySelect }}>{{ country.oxcountry__oxtitle.value|raw }}</option>
            {% endfor %}
        </select>
        <label for="invCountrySelect">{{ translate({ ident: "COUNTRY" }) }}{% if oView.isFieldRequired("oxuser__oxcountryid") %}*{% endif %}</label>
        <div class="invalid-feedback">
            {{ translate({ ident: "DD_FORM_VALIDATION_COUNTRY" }) }}
        </div>
        {% include "message/inputvalidation.html.twig" with {aErrors: aErrors.oxuser__oxcountryid} %}
    </div>

    {% if oViewConf.getViewThemeParam('bInputState') or oView.isFieldRequired("oxuser__oxstateid") %}
        <div class="form-floating mb-3">
            {% include "form/fieldset/state.html.twig" with {countrySelectId: "invCountrySelect", stateSelectName: "invadr[oxuser__oxstateid]", selectedStateIdPrim: invadr.oxuser__oxstateid, selectedStateId: oxcmp_user.oxuser__oxstateid.value, class: "form-select", id: "invadr_oxuser__oxstateid"} %}
            <label for="invadr_oxuser__oxstateid">{{ translate({ ident: "DD_USER_LABEL_STATE" }) }}{% if oView.isFieldRequired("oxuser__oxstateid") %}*{% endif %}</label>
            <div class="invalid-feedback">
                {{ translate({ ident: "DD_FORM_VALIDATION_STATE" }) }}
            </div>
        </div>
    {% endif %}
{% endblock %}

