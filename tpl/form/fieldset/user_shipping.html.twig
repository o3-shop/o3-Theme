{% if oxcmp_user %}
    {% set delivadr = oxcmp_user.getSelectedAddress() %}
{% endif %}

{% if not deladr %}
    {% set oConfig = oView.getConfig() %}
    {% set deladr = oConfig.getRequestParameter('deladr') %}
{% endif %}

{% if oxcmp_user %}
    {% set aUserAddresses = oxcmp_user.getUserAddresses() %}

    {% if aUserAddresses|length > 0 %}

        <input type="hidden" class="hidden" name="changeClass" value="{{ onChangeClass|default('account_user') }}">

        {# oxscript include="js/widgets/oxusershipingaddressselect.min.js" priority=10 #}
        {# oxscript add="$( '.dd-add-delivery-address' ).click( function() { $('.dd-available-addresses .dd-action').remove(); $( this ).find( 'label.btn' ).button('toggle'); } );" #}
        {# oxscript add="$( 'input[name=\"oxaddressid\"]' ).oxUserShipingAddressSelect();" #}

        {% block form_user_shipping_address_select %}

            {% for address in aUserAddresses %}

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="oxaddressid" value="{{ address.oxaddress__oxid.value|raw }}" id="address_{{ address.oxaddress__oxid.value|raw }}"{% if address.isSelected() %} checked{% endif %}>
                    <label class="form-check-label" for="address_{{ address.oxaddress__oxid.value|raw }}">
                        {% block form_user_shipping_address_actions %}
                            {% if address.isSelected() %}
                                {% block form_user_shipping_address_edit_action %}
                                    <button class="btn btn-edit" type="button" data-bs-toggle="collapse" data-bs-target="#user_shipppingaddress-address_{{ address.oxaddress__oxid.value|raw }}, #user__shippingaddress-form_{{ address.oxaddress__oxid.value|raw }}, #delete_{{ address.oxaddress__oxid.value|raw }}" aria-controls="user_shipppingaddress-address_{{ address.oxaddress__oxid.value|raw }}, user__shippingaddress-form_{{ address.oxaddress__oxid.value|raw }}, delete_{{ address.oxaddress__oxid.value|raw }}">
                                        {{ translate({ ident: "CHANGE" }) }}
                                    </button>
                                {% endblock %}
                                {% block form_user_shipping_address_delete_action %}
                                    <button class="btn btn-delete collapse show"
                                            type="button"
                                            id="delete_{{ address.oxaddress__oxid.value|raw }}"
                                            title="{{ translate({ ident: "DD_DELETE" }) }}"
                                            data-bs-toggle="modal"
                                            data-bs-target="#delete_shipping_address_{{ loop.index }}"
                                            aria-controls="delete_shipping_address_{{ loop.index }}">
                                        <svg width="18" height="20" viewBox="0 0 18 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M5.4375 2.3125H5.25C5.35313 2.3125 5.4375 2.22812 5.4375 2.125V2.3125ZM5.4375 2.3125H12.5625V2.125C12.5625 2.22812 12.6469 2.3125 12.75 2.3125H12.5625V4H14.25V2.125C14.25 1.29766 13.5773 0.625 12.75 0.625H5.25C4.42266 0.625 3.75 1.29766 3.75 2.125V4H5.4375V2.3125ZM17.25 4H0.75C0.335156 4 0 4.33516 0 4.75V5.5C0 5.60313 0.084375 5.6875 0.1875 5.6875H1.60312L2.18203 17.9453C2.21953 18.7445 2.88047 19.375 3.67969 19.375H14.3203C15.1219 19.375 15.7805 18.7469 15.818 17.9453L16.3969 5.6875H17.8125C17.9156 5.6875 18 5.60313 18 5.5V4.75C18 4.33516 17.6648 4 17.25 4ZM14.1398 17.6875H3.86016L3.29297 5.6875H14.707L14.1398 17.6875Z" fill="#D4D4D4"/>
                                        </svg>
                                    </button>
                                {% endblock %}
                            {% endif %}
                        {% endblock %}

                        {% include "widget/address/shipping_address.html.twig" with {delivadr: address, oxid: address.oxaddress__oxid.value} %}

                        {% if address.isSelected() %}
                            <div class="user__shippingaddress-form collapse" id="user__shippingaddress-form_{{ address.oxaddress__oxid.value|raw }}">
                                {# Anrede #}
                                {% if oView.isFieldRequired("oxaddress__oxsal") %}
                                    {% set salRequired = true %}
                                {% endif %}
                                <div class="form-floating mb-3">
                                    {% include "form/fieldset/salutation.html.twig" with {name: "deladr[oxaddress__oxsal]", value: delivadr.oxaddress__oxsal.value, value2: deladr.oxaddress__oxsal, class: "form-select", id: "deladr_oxaddress__oxsal", required: salRequired} %}
                                    <label for="deladr_oxaddress__oxsal">{{ translate({ ident: "TITLE" }) }}</label>
                                    <div class="invalid-feedback">
                                        {{ translate({ ident: "DD_FORM_VALIDATION_TITLE" }) }}
                                    </div>
                                </div>

                                {# Vorname #}
                                <div class="form-floating mb-3">
                                    <input class="form-control" type="text" maxlength="255" name="deladr[oxaddress__oxfname]" id="deladr_oxaddress__oxfname" placeholder="{{ translate({ ident: "FIRST_NAME" }) }}" autocomplete="shipping given-name" value="{% if delivadr.oxaddress__oxfname.value is not null %}{{ delivadr.oxaddress__oxfname.value|raw }}{% else %}{{ deladr.oxaddress__oxfname|raw }}{% endif %}"{% if oView.isFieldRequired("oxaddress__oxfname") %} required{% endif %}>
                                    <label for="deladr_oxaddress__oxfname">{{ translate({ ident: "FIRST_NAME" }) }}</label>
                                    <div class="invalid-feedback">
                                        {{ translate({ ident: "DD_FORM_VALIDATION_FIRST_NAME" }) }}
                                    </div>
                                </div>

                                {# Nachname #}
                                <div class="form-floating mb-3">
                                    <input class="form-control" type="text" maxlength="255" name="deladr[oxaddress__oxlname]" id="deladr_oxaddress__oxlname" placeholder="{{ translate({ ident: "LAST_NAME" }) }}" autocomplete="shipping family-name" value="{% if delivadr.oxaddress__oxlname.value is not null %}{{ delivadr.oxaddress__oxlname.value|raw }}{% else %}{{ deladr.oxaddress__oxlname|raw }}{% endif %}"{% if oView.isFieldRequired("oxaddress__oxlname") %} required{% endif %}>
                                    <label for="deladr_oxaddress__oxlname">{{ translate({ ident: "LAST_NAME" }) }}</label>
                                    <div class="invalid-feedback">
                                        {{ translate({ ident: "DD_FORM_VALIDATION_LAST_NAME" }) }}
                                    </div>
                                </div>

                                {# Firma #}
                                <div class="form-floating mb-3">
                                    <input class="form-control" type="text" maxlength="255" name="deladr[oxaddress__oxcompany]" id="deladr_oxaddress__oxcompany" placeholder="{{ translate({ ident: "COMPANY" }) }}" autocomplete="shipping organization" value="{% if delivadr.oxaddress__oxcompany.value is not null %}{{ delivadr.oxaddress__oxcompany.value|raw }}{% else %}{{ deladr.oxaddress__oxcompany|raw }}{% endif %}"{% if oView.isFieldRequired("oxaddress__oxcompany") %} required{% endif %}>
                                    <label for="deladr_oxaddress__oxcompany">{{ translate({ ident: "COMPANY" }) }}</label>
                                    <div class="invalid-feedback">
                                        {{ translate({ ident: "DD_FORM_VALIDATION_COMPANY" }) }}
                                    </div>
                                </div>

                                {# Zusätzliche Informationen #}
                                <div class="form-floating mb-3">
                                    <input class="form-control" type="text" maxlength="255" name="deladr[oxaddress__oxaddinfo]" id="deladr_oxaddress__oxaddinfo" placeholder="{{ translate({ ident: "ADDITIONAL_INFO" }) }}" value="{% if delivadr.oxaddress__oxaddinfo.value is not null %}{{ delivadr.oxaddress__oxaddinfo.value|raw }}{% else %}{{ deladr.oxaddress__oxaddinfo|raw }}{% endif %}"{% if oView.isFieldRequired("oxaddress__oxaddinfo") %} required{% endif %}>
                                    <label for="deladr_oxaddress__oxaddinfo">{{ translate({ ident: "ADDITIONAL_INFO" }) }}</label>
                                </div>

                                {# Straße und Hausnummer #}
                                <div class="row">
                                    <div class="form-floating mb-3 col-xl-8 pe-xl-0">
                                        <input class="form-control" type="text" maxlength="255" name="deladr[oxaddress__oxstreet]" id="deladr_oxaddress__oxstreet" placeholder="{{ translate({ ident: "O3_STREET" }) }}" autocomplete="shipping street-address" value="{% if delivadr.oxaddress__oxstreet.value is not null %}{{ delivadr.oxaddress__oxstreet.value|raw }}{% else %}{{ deladr.oxaddress__oxstreet|raw }}{% endif %}"{% if oView.isFieldRequired("oxaddress__oxstreet") %} required{% endif %}>
                                        <label for="deladr_oxaddress__oxstreet">{{ translate({ ident: "O3_STREET" }) }}</label>
                                        <div class="invalid-feedback">
                                            {{ translate({ ident: "DD_FORM_VALIDATION_STREET" }) }}
                                        </div>
                                    </div>
                                    <div class="form-floating mb-3 col-xl-4">
                                        <input class="form-control" type="text" maxlength="16" name="deladr[oxaddress__oxstreetnr]" id="deladr_oxaddress__oxstreetnr" placeholder="{{ translate({ ident: "O3_STREETNO" }) }}" value="{% if delivadr.oxaddress__oxstreetnr.value is not null %}{{ delivadr.oxaddress__oxstreetnr.value|raw }}{% else %}{{ deladr.oxaddress__oxstreetnr|raw }}{% endif %}"{% if oView.isFieldRequired("oxaddress__oxstreetnr") %} required{% endif %}>
                                        <label for="deladr_oxaddress__oxstreetnr">{{ translate({ ident: "O3_STREETNO" }) }}</label>
                                        <div class="invalid-feedback">
                                            {{ translate({ ident: "DD_FORM_VALIDATION_STREETNO" }) }}
                                        </div>
                                    </div>
                                </div>

                                {# PLZ und Ort #}
                                <div class="row">
                                    <div class="form-floating mb-3 col-xl-4">
                                        <input class="form-control" type="text" maxlength="50" name="deladr[oxaddress__oxzip]" id="deladr_oxaddress__oxzip" placeholder="{{ translate({ ident: "O3_POSTAL_CODE" }) }}" autocomplete="shipping postal-code" value="{% if delivadr.oxaddress__oxzip.value is not null %}{{ delivadr.oxaddress__oxzip.value|raw }}{% else %}{{ deladr.oxaddress__oxzip|raw }}{% endif %}"{% if oView.isFieldRequired("oxaddress__oxzip") %} required{% endif %}>
                                        <label for="deladr_oxaddress__oxzip">{{ translate({ ident: "O3_POSTAL_CODE" }) }}</label>
                                        <div class="invalid-feedback">
                                            {{ translate({ ident: "DD_FORM_VALIDATION_POSTAL_CODE" }) }}
                                        </div>
                                    </div>
                                    <div class="form-floating mb-3 col-xl-8 ps-xl-0">
                                        <input class="form-control" type="text" maxlength="255" name="deladr[oxaddress__oxcity]" id="deladr_oxaddress__oxcity" placeholder="{{ translate({ ident: "O3_CITY" }) }}" autocomplete="shipping locality" value="{% if delivadr.oxaddress__oxcity.value is not null %}{{ delivadr.oxaddress__oxcity.value|raw }}{% else %}{{ deladr.oxaddress__oxcity|raw }}{% endif %}"{% if oView.isFieldRequired("oxaddress__oxcity") %} required{% endif %}>
                                        <label for="deladr_oxaddress__oxcity">{{ translate({ ident: "O3_CITY" }) }}</label>
                                        <div class="invalid-feedback">
                                            {{ translate({ ident: "DD_FORM_VALIDATION_CITY" }) }}
                                        </div>
                                    </div>
                                </div>

                                {# 1.x has this block three times with different bodies (edit form of the selected address, form for a new address,
                                   form when the user has no address); Twig allows one definition per template, so it is defined once here and
                                   rendered with block() at the other two places. sShippingCountryForm tells the variant: unset = edit, 'new', 'register'. #}
                                {% block form_user_shipping_country %}
                                {% if sShippingCountryForm|default('') == 'new' %}
                                    <div class="form-floating mb-3">
                                        <select disabled class="form-select" id="delCountrySelect" name="deladr[oxaddress__oxcountryid]"{% if oView.isFieldRequired("oxaddress__oxcountryid") %} required{% endif %} autocomplete="shipping country">
                                            <option value="">-</option>
                                            {% set blCountrySelected = false %}
                                            {% for country_id, country in oViewConf.getCountryList() %}
                                                {% set sCountrySelect = "" %}
                                                {% if not blCountrySelected %}
                                                    {% if (deladr.oxaddress__oxcountryid is not null and deladr.oxaddress__oxcountryid == country.oxcountry__oxid.value) or                                        (deladr.oxaddress__oxcountryid is null and (delivadr.oxaddress__oxcountry.value == country.oxcountry__oxtitle.value or                                        delivadr.oxaddress__oxcountry.value == country.oxcountry__oxid.value or                                        delivadr.oxaddress__oxcountryid.value == country.oxcountry__oxid.value)) %}
                                                    {% set blCountrySelected = true %}
                                                    {% set sCountrySelect = "selected" %}
                                                    {% endif %}
                                                {% endif %}
                                                <option value="{{ country.oxcountry__oxid.value|raw }}" {{ sCountrySelect }}>{{ country.oxcountry__oxtitle.value|raw }}</option>
                                            {% endfor %}
                                        </select>
                                        <label for="delCountrySelect">{{ translate({ ident: "COUNTRY" }) }}{% if oView.isFieldRequired("oxaddress__oxcountryid") %}*{% endif %}</label>
                                        <div class="invalid-feedback">
                                            {{ translate({ ident: "DD_FORM_VALIDATION_COUNTRY" }) }}
                                        </div>
                                    </div>

                                    <div class="form-floating mb-3">
                                            {% include "form/fieldset/state.html.twig" with {countrySelectId: "delCountrySelect", stateSelectName: "deladr[oxaddress__oxstateid]", selectedStateIdPrim: deladr.oxaddress__oxstateid, selectedStateId: delivadr.oxaddress__oxstateid.value, class: "form-select", disabled: true} %}
                                        <label for="{{ countrySelectId }}">{{ translate({ ident: "DD_USER_LABEL_STATE" }) }}</label>
                                        <div class="invalid-feedback">
                                            {{ translate({ ident: "DD_FORM_VALIDATION_COUNTRY" }) }}
                                        </div>
                                    </div>
                                {% elseif sShippingCountryForm|default('') == 'register' %}
                                    <div class="form-floating mb-3">
                                        <select disabled class="form-select" id="delCountrySelect" name="deladr[oxaddress__oxcountryid]" autocomplete="shipping country"{% if oView.isFieldRequired("oxaddress__oxcountryid") %} required{% endif %}>
                                            <option value="">-</option>
                                            {% set blCountrySelected = false %}
                                            {% for country_id, country in oViewConf.getCountryList() %}
                                                {% set sCountrySelect = "" %}
                                                {% if not blCountrySelected %}
                                                    {% if (deladr.oxaddress__oxcountryid is not null and deladr.oxaddress__oxcountryid == country.oxcountry__oxid.value) or                        (deladr.oxaddress__oxcountryid is null and (delivadr.oxaddress__oxcountry.value == country.oxcountry__oxtitle.value or                        delivadr.oxaddress__oxcountry.value == country.oxcountry__oxid.value or                        delivadr.oxaddress__oxcountryid.value == country.oxcountry__oxid.value)) %}
                                                    {% set blCountrySelected = true %}
                                                    {% set sCountrySelect = "selected" %}
                                                    {% endif %}
                                                {% endif %}
                                                <option value="{{ country.oxcountry__oxid.value|raw }}" {{ sCountrySelect }}>{{ country.oxcountry__oxtitle.value|raw }}</option>
                                            {% endfor %}
                                        </select>
                                        <label for="delCountrySelect">{{ translate({ ident: "COUNTRY" }) }}{% if oView.isFieldRequired("oxaddress__oxcountryid") %}*{% endif %}</label>
                                        {% if oView.isFieldRequired("oxaddress__oxcountryid") %}
                                            <div class="invalid-feedback">{{ translate({ ident: "DD_FORM_VALIDATION_COUNTRY" }) }}</div>
                                            {% include "message/inputvalidation.html.twig" with {aErrors: aErrors.oxaddress__oxcountryid} %}
                                        {% endif %}
                                    </div>

                                    <div class="form-floating mb-3">
                                        {% include "form/fieldset/state.html.twig" with {countrySelectId: "delCountrySelect", stateSelectName: "deladr[oxaddress__oxstateid]", selectedStateIdPrim: deladr.oxaddress__oxstateid, selectedStateId: delivadr.oxaddress__oxstateid.value, class: "form-select", disabled: true} %}
                                        <label for="{{ countrySelectId }}">{{ translate({ ident: "DD_USER_LABEL_STATE" }) }}</label>
                                        <div class="invalid-feedback">{{ translate({ ident: "DD_FORM_VALIDATION_STATE" }) }}</div>
                                    </div>
                                {% else %}
                                    <div class="form-floating mb-3">
                                        <select class="form-select" id="delCountrySelect" name="deladr[oxaddress__oxcountryid]"{% if oView.isFieldRequired("oxaddress__oxcountryid") %} required{% endif %} autocomplete="shipping country">
                                            <option value="">-</option>
                                            {% set blCountrySelected = false %}
                                            {% for country_id, country in oViewConf.getCountryList() %}
                                            {% set sCountrySelect = "" %}
                                            {% if not blCountrySelected %}
                                            {% if (deladr.oxaddress__oxcountryid is not null and deladr.oxaddress__oxcountryid == country.oxcountry__oxid.value) or                                        (deladr.oxaddress__oxcountryid is null and (delivadr.oxaddress__oxcountry.value == country.oxcountry__oxtitle.value or                                        delivadr.oxaddress__oxcountry.value == country.oxcountry__oxid.value or                                        delivadr.oxaddress__oxcountryid.value == country.oxcountry__oxid.value)) %}
                                            {% set blCountrySelected = true %}
                                            {% set sCountrySelect = "selected" %}
                                            {% endif %}
                                            {% endif %}
                                            <option value="{{ country.oxcountry__oxid.value|raw }}" {{ sCountrySelect }}>{{ country.oxcountry__oxtitle.value|raw }}</option>
                                            {% endfor %}
                                        </select>
                                        <label for="delCountrySelect">{{ translate({ ident: "COUNTRY" }) }}</label>
                                        <div class="invalid-feedback">
                                            {{ translate({ ident: "DD_FORM_VALIDATION_COUNTRY" }) }}
                                        </div>
                                    </div>

                                    <div class="form-floating mb-3">
                                        {% include "form/fieldset/state.html.twig" with {countrySelectId: "delCountrySelect", stateSelectName: "deladr[oxaddress__oxstateid]", selectedStateIdPrim: deladr.oxaddress__oxstateid, selectedStateId: delivadr.oxaddress__oxstateid.value, class: "form-select"} %}
                                        <label for="{{ countrySelectId }}">{{ translate({ ident: "DD_USER_LABEL_STATE" }) }}</label>
                                        <div class="invalid-feedback">
                                            {{ translate({ ident: "DD_FORM_VALIDATION_COUNTRY" }) }}
                                        </div>
                                    </div>
                                {% endif %}
                                {% endblock %}

                                {# Telefon #}
                                <div class="form-floating mb-3">
                                    <input class="form-control" type="text" maxlength="128" name="deladr[oxaddress__oxfon]" id="deladr_oxaddress__oxfon" placeholder="{{ translate({ ident: "PHONE" }) }}" autocomplete="shipping tel" value="{% if delivadr.oxaddress__oxfon.value is not null %}{{ delivadr.oxaddress__oxfon.value|raw }}{% else %}{{ deladr.oxaddress__oxfon|raw }}{% endif %}"{% if oView.isFieldRequired("oxaddress__oxfon") %} required{% endif %}>
                                    <label for="deladr_oxaddress__oxfon">{{ translate({ ident: "PHONE" }) }}</label>
                                    <div class="invalid-feedback">
                                        {{ translate({ ident: "DD_FORM_VALIDATION_PHONE" }) }}
                                    </div>
                                </div>

                                {# Telefax #}
                                <div class="form-floating mb-3">
                                    <input class="form-control" type="text" maxlength="128" name="deladr[oxaddress__oxfax]" id="deladr_oxaddress__oxfax" placeholder="{{ translate({ ident: "FAX" }) }}" value="{% if delivadr.oxaddress__oxfax.value is not null %}{{ delivadr.oxaddress__oxfax.value|raw }}{% else %}{{ deladr.oxaddress__oxfax|raw }}{% endif %}"{% if oView.isFieldRequired("oxaddress__oxfax") %} required{% endif %}>
                                    <label for="deladr_oxaddress__oxfax">{{ translate({ ident: "FAX" }) }}</label>
                                </div>
                                <div class="invalid-feedback">
                                    {{ translate({ ident: "DD_FORM_VALIDATION_FAX" }) }}
                                </div>

                                {% if not noFormSubmit %}
                                    <div class="mb-3">
                                        <p class="alert alert-info">{{ translate({ ident: "COMPLETE_MARKED_FIELDS" }) }}</p>
                                        <button id="accUserSaveBottom" type="submit" name="save">{{ translate({ ident: "SAVE" }) }}</button>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                    </label>
                </div>

            {% endfor %}

            <div class="form-check">
                <input class="form-check-input" type="radio" name="oxaddressid" value="-1" id="address_new">
                <label class="form-check-label" for="address_new">
                    {{ translate({ ident: "DD_USER_SHIPPING_ADD_DELIVERY_ADDRESS" }) }}


                    <div class="user__shippingaddress-form">

                        {# Anrede #}
                        {% if oView.isFieldRequired("oxaddress__oxsal") %}
                            {% set salRequired = true %}
                        {% endif %}

                        <div class="form-floating mb-3">
                            {% include "form/fieldset/salutation.html.twig" with {name: "deladr[oxaddress__oxsal]", value: delivadr.oxaddress__oxsal.value, value2: deladr.oxaddress__oxsal, class: "form-select", id: "deladr_oxaddress__oxsal", required: salRequired, disabled: true} %}
                            <label for="deladr_oxaddress__oxsal">{{ translate({ ident: "TITLE" }) }}</label>
                            <div class="invalid-feedback">
                                {{ translate({ ident: "DD_FORM_VALIDATION_TITLE" }) }}
                            </div>
                        </div>

                        {# Vorname #}
                        <div class="form-floating mb-3">
                            <input disabled class="form-control" type="text" maxlength="255" name="deladr[oxaddress__oxfname]" id="deladr_oxaddress__oxfname" placeholder="{{ translate({ ident: "FIRST_NAME" }) }}{% if oView.isFieldRequired("oxaddress__oxfname") %}*{% endif %}" autocomplete="shipping given-name" value=""{% if oView.isFieldRequired("oxaddress__oxfname") %} required{% endif %}>
                            <label for="deladr_oxaddress__oxfname">{{ translate({ ident: "FIRST_NAME" }) }}{% if oView.isFieldRequired("oxaddress__oxfname") %}*{% endif %}</label>
                            <div class="invalid-feedback">
                                {{ translate({ ident: "DD_FORM_VALIDATION_FIRST_NAME" }) }}
                            </div>
                            {% include "message/inputvalidation.html.twig" with {aErrors: aErrors.oxaddress__oxfname} %}
                        </div>

                        {# Nachname #}
                        <div class="form-floating mb-3">
                            <input disabled class="form-control" type="text" maxlength="255" name="deladr[oxaddress__oxlname]" id="deladr_oxaddress__oxlname" placeholder="{{ translate({ ident: "LAST_NAME" }) }}{% if oView.isFieldRequired("oxaddress__oxlname") %}*{% endif %}" autocomplete="shipping family-name" value=""{% if oView.isFieldRequired("oxaddress__oxlname") %} required{% endif %}>
                            <label for="deladr_oxaddress__oxlname">{{ translate({ ident: "LAST_NAME" }) }}{% if oView.isFieldRequired("oxaddress__oxlname") %}*{% endif %}</label>
                            <div class="invalid-feedback">
                                {{ translate({ ident: "DD_FORM_VALIDATION_LAST_NAME" }) }}
                            </div>
                            {% include "message/inputvalidation.html.twig" with {aErrors: aErrors.oxaddress__oxlname} %}
                        </div>

                        {# Firma #}
                        <div class="form-floating mb-3">
                            <input disabled class="form-control" type="text" maxlength="255" name="deladr[oxaddress__oxcompany]" id="deladr_oxaddress__oxcompany" placeholder="{{ translate({ ident: "COMPANY" }) }}{% if oView.isFieldRequired("oxaddress__oxcompany") %}*{% endif %}" autocomplete="shipping organization" value=""{% if oView.isFieldRequired("oxaddress__oxcompany") %} required{% endif %}>
                            <label for="deladr_oxaddress__oxcompany">{{ translate({ ident: "COMPANY" }) }}{% if oView.isFieldRequired("oxaddress__oxcompany") %}*{% endif %}</label>
                            <div class="invalid-feedback">
                                {{ translate({ ident: "DD_FORM_VALIDATION_COMPANY" }) }}
                            </div>
                            {% include "message/inputvalidation.html.twig" with {aErrors: aErrors.oxaddress__oxcompany} %}
                        </div>

                        {# Zusätzliche Informationen #}
                        <div class="form-floating mb-3">
                            <input disabled class="form-control" type="text" maxlength="255" name="deladr[oxaddress__oxaddinfo]" id="deladr_oxaddress__oxaddinfo" placeholder="{{ translate({ ident: "ADDITIONAL_INFO" }) }}{% if oView.isFieldRequired("oxaddress__oxaddinfo") %}*{% endif %}" value=""{% if oView.isFieldRequired("oxaddress__oxaddinfo") %} required{% endif %}>
                            <label for="deladr_oxaddress__oxaddinfo">{{ translate({ ident: "ADDITIONAL_INFO" }) }}{% if oView.isFieldRequired("oxaddress__oxaddinfo") %}*{% endif %}</label>
                            {% include "message/inputvalidation.html.twig" with {aErrors: aErrors.oxaddress__oxaddinfo} %}
                        </div>

                        {# Straße und Hausnummer #}
                        <div class="row">
                            <div class="form-floating mb-3 col-xl-8 pe-xl-0">
                                <input disabled class="form-control" type="text" maxlength="255" name="deladr[oxaddress__oxstreet]" id="deladr_oxaddress__oxstreet" placeholder="{{ translate({ ident: "O3_STREET" }) }}{% if oView.isFieldRequired("oxaddress__oxstreet") %}*{% endif %}" autocomplete="shipping street-address" value=""{% if oView.isFieldRequired("oxaddress__oxstreet") %} required{% endif %}>
                                <label for="deladr_oxaddress__oxstreet">{{ translate({ ident: "O3_STREET" }) }}{% if oView.isFieldRequired("oxaddress__oxstreet") %}*{% endif %}</label>
                                <div class="invalid-feedback">
                                    {{ translate({ ident: "DD_FORM_VALIDATION_STREET" }) }}
                                </div>
                                {% include "message/inputvalidation.html.twig" with {aErrors: aErrors.oxaddress__oxstreet} %}
                            </div>
