                                <input disabled class="form-control" type="text" maxlength="16" name="deladr[oxaddress__oxstreetnr]" id="deladr_oxaddress__oxstreetnr" placeholder="{{ translate({ ident: "O3_STREETNO" }) }}{% if oView.isFieldRequired("oxaddress__oxstreetnr") %}*{% endif %}" value=""{% if oView.isFieldRequired("oxaddress__oxstreetnr") %} required{% endif %}>
                                <label for="deladr_oxaddress__oxstreetnr">{{ translate({ ident: "O3_STREETNO" }) }}{% if oView.isFieldRequired("oxaddress__oxstreetnr") %}*{% endif %}</label>
