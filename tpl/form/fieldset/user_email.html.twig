<div class="form-floating mb-3">
    <input class="form-control" type="email" name="invadr[oxuser__oxusername]" value="{% if invadr.oxuser__oxusername is not null %}{{ invadr.oxuser__oxusername|raw }}{% else %}{{ oxcmp_user.oxuser__oxusername.value|raw }}{% endif %}" placeholder="{{ translate({ ident: "EMAIL_ADDRESS" }) }}" autocomplete="username">
    <label for="email">{{ translate({ ident: "EMAIL_ADDRESS" }) }}</label>
    <div class="invalid-feedback">
        {{ translate({ ident: "DD_FORM_VALIDATION_VALIDEMAIL" }) }}
    </div>
</div>

