{% if oxcmp_user.oxuser__oxpassword.value %}
    <div class="form-floating mb-3"{% if not aErrors.oxuser__oxpassword %} style="display:none;"{% endif %}>
        <input class="form-control" type="password" name="user_password" placeholder="{{ translate({ ident: "PASSWORD" }) }}" autocomplete="new-password">
        <label for="password">{{ translate({ ident: "PASSWORD" }) }}</label>
        <div class="invalid-feedback">
            {{ translate({ ident: "ERROR_MESSAGE_INPUT_EMPTYPASS" }) }}
        </div>
    </div>
{% endif %}

