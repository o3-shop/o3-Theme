{% if blSubscribeNews %}
    {% block user_billing_newsletter %}
        <div class="user__newsletter mb-5">
            <h3 class="title-small">
                {{ translate({ ident: "NEWSLETTER" }) }}
            </h3>
            <input type="hidden" name="blnewssubscribed" value="0">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="blnewssubscribed" value="1" id="subscribeNewsletter"{% if oView.isNewsSubscribed() %} checked{% endif %}>
                <label class="form-check-label" for="subscribeNewsletter">
                    {{ translate({ ident: "NEWSLETTER_SUBSCRIPTION" }) }}
                </label>
            </div>
            <div>{{ translate({ ident: "MESSAGE_NEWSLETTER_SUBSCRIPTION" }) }}</div>
        </div>
