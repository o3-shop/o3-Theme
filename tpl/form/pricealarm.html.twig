{% if oxcmp_shop.oxshops__oxproductive.value %}
    {{ script({ include: "js/widget/validate.min.js", priority: 10 }) }}
{% else %}
    {{ script({ include: "js/widget/validate.js", priority: 10 }) }}
{% endif %}

{% set currency = oView.getActCurrency() %}
<p class="alert alert-info">{{ translate({ ident: "MESSAGE_PRICE_ALARM_PRICE_CHANGE" }) }}</p>

<form action="{{ oViewConf.getSelfActionLink()|raw }}" name="pricealarm" method="post" class="needs-validation" novalidate>
    <div class="d-none">
        {{ oViewConf.getHiddenSid()|raw }}
        {{ oViewConf.getNavFormParams()|raw }}
        <input type="hidden" name="cl" value="{{ oViewConf.getTopActiveClassName() }}">
        {% if oDetailsProduct %}
            <input type="hidden" name="anid" value="{{ oDetailsProduct.oxarticles__oxid.value|raw }}">
        {% endif %}
        <input type="hidden" name="fnc" value="addme">
    </div>

    <div class="form-floating mb-3">
        <input type="text" class="form-control" id="price" name="pa[price]" maxlength="32" value="{% hasrights { ident: "SHOWARTICLEPRICE" } %}{% if product %}{{ product.getFPrice() }}{% endif %}{% endhasrights %}" placeholder="{{ translate({ ident: "YOUR_PRICE" }) }} ({{ currency.sign }})" required>
        <label for="price">{{ translate({ ident: "YOUR_PRICE" }) }} ({{ currency.sign }})</label>
        <div class="invalid-feedback">{{ translate({ ident: "O3_PRICEALARM_FEEDBACK" }) }}</div>
    </div>

    <div class="form-floating mb-3">
        <input type="email" class="form-control" id="email" name="pa[email]" value="{% if oxcmp_user %}{{ oxcmp_user.oxuser__oxusername.value|raw }}{% endif %}" maxlength="128" placeholder="{{ translate({ ident: "EMAIL" }) }}" required>
        <label for="email">{{ translate({ ident: "EMAIL" }) }}</label>
        <div class="invalid-feedback">{{ translate({ ident: "DD_FORM_VALIDATION_VALIDEMAIL" }) }}</div>
    </div>

    {% block captcha_form %}{{ oViewConf.getCaptchaWidget('pricealarm')|raw }}{% endblock %}

    <button class="btn btn-primary" type="submit">{{ translate({ ident: "SEND" }) }}</button>

</form>