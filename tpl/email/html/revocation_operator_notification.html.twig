{% set shop = oEmailView.getShop() %}
{% include "email/html/header.html.twig" with {title: "O3_REVOCATION_OPERATOR_EMAIL_SUBJECT"|translate} %}

<p>{{ translate({ ident: "O3_REVOCATION_OPERATOR_EMAIL_BODY" }) }}</p>

<dl>
    <dt><strong>{{ translate({ ident: "O3_REVOCATION_ADMIN_FIELD_OXID" }) }}:</strong></dt>
    <dd><code>{{ submission.getId()|escape('html') }}</code></dd>

    <dt><strong>{{ translate({ ident: "O3_REVOCATION_ADMIN_FIELD_SUBMITTED" }) }}:</strong></dt>
    <dd>{{ submission.o3revocation__oxsubmitted.value|raw }}</dd>

    <dt><strong>{{ translate({ ident: "O3_REVOCATION_FIELD_NAME_LABEL" }) }}:</strong></dt>
    <dd>{{ submission.o3revocation__oxname.getRawValue()|escape('html') }}</dd>

    <dt><strong>{{ translate({ ident: "O3_REVOCATION_FIELD_ORDERNUMBER_LABEL" }) }}:</strong></dt>
    <dd>{{ submission.o3revocation__oxorderident.getRawValue()|escape('html') }}</dd>

    <dt><strong>{{ translate({ ident: "O3_REVOCATION_FIELD_EMAIL_LABEL" }) }}:</strong></dt>
    <dd>{{ submission.o3revocation__oxemail.getRawValue()|escape('html') }}</dd>

    {% if submission.o3revocation__oxfreetext.value %}
        <dt><strong>{{ translate({ ident: "O3_REVOCATION_FIELD_FREETEXT_LABEL" }) }}:</strong></dt>
        <dd><pre>{{ submission.o3revocation__oxfreetext.getRawValue()|escape('html') }}</pre></dd>
    {% endif %}
</dl>

{% include "email/html/footer.html.twig" %}
